# .env.example — committed. Documents what's needed, holds no values.

# The Jasypt master password. Decrypts every ENC(...) value in application*.properties.
# Generate with: openssl rand -base64 32
# Never commit the real value. In production this comes from the container environment.
JASYPT_ENCRYPTOR_PASSWORD=

# Which profile to run. Note: application.properties hardcodes `dev`;
# production MUST override this (see Day 4).
SPRING_PROFILES_ACTIVE=dev

# --- Grafana Cloud ---------------------------------------------------
# grafana.com -> your stack -> Details. GC_TOKEN is the "alloy" access-policy token
# (metrics:write, logs:write) - the only Grafana token that ever goes on a node.
GC_PROM_URL=
GC_PROM_USER=
GC_LOKI_URL=
GC_LOKI_USER=
GC_TOKEN=

# For mimirtool on this machine only: the Prometheus query endpoint and the
# "ops" token (rules:read, rules:write, metrics:read). Never put the ops token on a node.
GC_PROM_API=
GC_OPS_TOKEN=