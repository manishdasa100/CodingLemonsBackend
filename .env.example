# .env.example — committed. Documents what's needed, holds no values.

# The Jasypt master password. Decrypts every ENC(...) value in application*.properties.
# Generate with: openssl rand -base64 32
# Never commit the real value. In production this comes from the container environment.
JASYPT_ENCRYPTOR_PASSWORD=

# Which profile to run. Note: application.properties hardcodes `dev`;
# production MUST override this (see Day 4).
SPRING_PROFILES_ACTIVE=dev